# Omit to run the isolated, in-memory sample-data experience.
VITE_CONVEX_URL=
# All remaining values are Convex deployment environment variables, NEVER VITE_ variables.
SITE_URL=http://localhost:5173
PAUBOX_API_KEY=
PAUBOX_API_URL=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
GHL_WORKFLOW_SECRET=
GHL_PIPELINE_ID=
GHL_STATUS_FIELD_ID=
GHL_EVAL_CALENDAR_ID=
STRIPE_MEMBERSHIP_PRODUCT_ID=
# Set by Convex/Auth setup in the backend environment, not the frontend:
# CONVEX_SITE_URL, JWT_PRIVATE_KEY, JWKS
# JSON mapping of internal pipeline keys to GHL stage IDs
GHL_STAGE_IDS={}
# Explicit server-side production release gates
ALLOW_REAL_PATIENTS=false
ENABLE_CARE=false
ENABLE_RETENTION=false
# Comma-separated synthetic recipients. Required whenever ALLOW_REAL_PATIENTS=false.
STAGING_EMAIL_ALLOWLIST=easyflowfinancial@gmail.com
STAGING_PHONE_ALLOWLIST=+15733030992
STAGING_TEST_EMAIL=easyflowfinancial@gmail.com
STAGING_TEST_PHONE=+15733030992
